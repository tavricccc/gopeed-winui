<Page x:Class="Gopeed_Native.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:Gopeed_Native.Models" AllowDrop="True" DragOver="DownloadDragOver" Drop="DownloadDrop">
 <Page.KeyboardAccelerators><KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewShortcut"/><KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchShortcut"/><KeyboardAccelerator Key="A" Modifiers="Control" Invoked="SelectAllShortcut"/><KeyboardAccelerator Key="Delete" Invoked="DeleteShortcut"/><KeyboardAccelerator Key="F5" Invoked="RefreshShortcut"/></Page.KeyboardAccelerators>
 <Grid RowSpacing="10">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <CommandBar DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" Background="Transparent" Margin="8,4,8,0">
   <AppBarButton x:Name="BackToDownloads" Label="下載清單" Icon="Back" Click="ShowDownloads" Visibility="Collapsed"/>
   <AppBarButton Label="新增下載" Icon="Add" Click="AddDownload" IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AutomationId="AddDownload"/>
   <AppBarButton Label="貼上網址" Icon="Paste" Click="PasteDownload" IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"/>
   <AppBarSeparator/>
   <AppBarButton Label="全部暫停" Icon="Pause" Click="PauseAll"/>
   <AppBarButton Label="全部繼續" Icon="Play" Click="ResumeAll"/>
   <AppBarButton Label="詳細資訊" Click="ShowDetails" IsEnabled="{x:Bind ViewModel.HasSingleSelection, Mode=OneWay}"><AppBarButton.Icon><FontIcon Glyph="&#xE946;"/></AppBarButton.Icon></AppBarButton>
   <AppBarButton Label="擴充功能" Icon="AllApps" Click="ShowExtensions" IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"/>
   <AppBarButton Label="設定" Icon="Setting" Click="ShowSettings" IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}" AutomationProperties.AutomationId="SettingsItem"/>
   <CommandBar.SecondaryCommands>
    <AppBarButton Icon="Pause" Label="暫停選取" Click="PauseSelected" IsEnabled="{x:Bind ViewModel.CanPauseSelected, Mode=OneWay}"/>
    <AppBarButton Icon="Play" Label="繼續選取" Click="ResumeSelected" IsEnabled="{x:Bind ViewModel.CanResumeSelected, Mode=OneWay}"/>
    <AppBarButton Icon="Edit" Label="修改下載來源" Click="EditSelectedSource" IsEnabled="{x:Bind ViewModel.CanEditSource, Mode=OneWay}"/>
    <AppBarButton Icon="Download" Label="重新下載" Click="Redownload" IsEnabled="{x:Bind ViewModel.HasSingleSelection, Mode=OneWay}"/>
    <AppBarButton Icon="Copy" Label="複製選取網址" Click="CopySelected" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"/>
    <AppBarButton Icon="Delete" Label="移除選取" Click="DeleteSelected" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"/>
    <AppBarButton Icon="SelectAll" Label="選取全部" Click="SelectAll"/>
    <AppBarButton Icon="Clear" Label="清除完成紀錄" Click="ClearCompleted"/>
    <AppBarButton Icon="Refresh" Label="重新整理" Click="RefreshClicked"/>
   </CommandBar.SecondaryCommands>
  </CommandBar>
  <InfoBar x:Name="ErrorBar" Grid.Row="1" Margin="16,0" IsOpen="False" Severity="Error" IsClosable="True"/>
  <Grid x:Name="DownloadsSurface" Grid.Row="2" RowSpacing="8">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Margin="20,0" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
    <ComboBox x:Name="FilterBox" SelectedIndex="0" SelectionChanged="FilterChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="下載狀態篩選"><ComboBoxItem Content="全部下載" Tag="all"/><ComboBoxItem Content="進行中" Tag="active"/><ComboBoxItem Content="已暫停" Tag="pause"/><ComboBoxItem Content="已完成" Tag="done"/><ComboBoxItem Content="失敗" Tag="error"/></ComboBox>
    <AutoSuggestBox Grid.Column="1" x:Name="SearchBox" PlaceholderText="搜尋檔名或來源" QueryIcon="Find" TextChanged="SearchChanged" AutomationProperties.AutomationId="DownloadSearch" AutomationProperties.Name="搜尋下載"/>
    <ComboBox Grid.Column="2" SelectedIndex="0" SelectionChanged="SortChanged" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="DownloadSort" AutomationProperties.Name="下載排序"><ComboBoxItem Content="最新加入" Tag="newest"/><ComboBoxItem Content="最舊在前" Tag="oldest"/><ComboBoxItem Content="檔名 A–Z" Tag="name"/><ComboBoxItem Content="檔案大小" Tag="size"/><ComboBoxItem Content="下載進度" Tag="progress"/></ComboBox>
   </Grid>
   <Grid Grid.Row="1" Margin="24,2,24,0" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="152"/><ColumnDefinition Width="88"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
    <TextBlock Text="檔名" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <TextBlock Grid.Column="1" Text="下載大小" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <TextBlock Grid.Column="2" Text="進度／狀態" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <TextBlock Grid.Column="3" Text="速度" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   </Grid>
   <ListView Grid.Row="2" x:Name="DownloadList" ItemsSource="{x:Bind ViewModel.VisibleItems, Mode=OneWay}" SelectionMode="Extended" SelectionChanged="DownloadSelectionChanged" DoubleTapped="ListDoubleTapped" Padding="8,0,8,8" ScrollViewer.HorizontalScrollMode="Disabled" AutomationProperties.AutomationId="DownloadList">
    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,6"/><Setter Property="MinHeight" Value="44"/></Style></ListView.ItemContainerStyle>
    <ListView.ItemTemplate><DataTemplate x:DataType="models:DownloadItem">
     <Grid ColumnSpacing="12" ToolTipService.ToolTip="{x:Bind DetailsText, Mode=OneWay}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="152"/><ColumnDefinition Width="88"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
      <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="{x:Bind FileGlyph, Mode=OneWay}" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}"/></Grid>
      <TextBlock Grid.Column="1" Text="{x:Bind TransferSizeText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Grid Grid.Column="2" ColumnSpacing="8" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ProgressBar Value="{x:Bind Percent, Mode=OneWay}" Maximum="100" IsIndeterminate="False" Visibility="{x:Bind ProgressVisibility, Mode=OneWay}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{x:Bind RowProgressText, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"/></Grid>
      <TextBlock Grid.Column="3" Text="{x:Bind SpeedText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
       <Button Tag="{x:Bind Id}" Click="RowPrimary" Style="{StaticResource RowPrimaryButtonStyle}" IsEnabled="{x:Bind CanAct, Mode=OneWay}" AutomationProperties.Name="{x:Bind PrimaryActionLabel, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind PrimaryActionLabel, Mode=OneWay}"><FontIcon Glyph="{x:Bind PrimaryActionGlyph, Mode=OneWay}" FontSize="14"/></Button>
       <Button Tag="{x:Bind Id}" Click="RowFolder" Style="{StaticResource RowActionButtonStyle}" AutomationProperties.Name="在資料夾中顯示" ToolTipService.ToolTip="在資料夾中顯示"><FontIcon Glyph="&#xE8B7;" FontSize="14"/></Button>
       <Button Tag="{x:Bind Id}" Click="RowDelete" Style="{StaticResource RowActionButtonStyle}" AutomationProperties.Name="移除下載" ToolTipService.ToolTip="移除下載"><FontIcon Glyph="&#xE711;" FontSize="14"/></Button>
      </StackPanel>
      <Grid.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="{x:Bind PrimaryActionLabel, Mode=OneWay}" Click="ContextPrimary" IsEnabled="{x:Bind CanAct, Mode=OneWay}" Tag="{x:Bind Id}"><MenuFlyoutItem.Icon><FontIcon Glyph="{x:Bind PrimaryActionGlyph, Mode=OneWay}"/></MenuFlyoutItem.Icon></MenuFlyoutItem><MenuFlyoutItem Text="在資料夾中顯示" Icon="Folder" Click="ContextFolder" Tag="{x:Bind Id}"/><MenuFlyoutItem Text="檔案與詳細資訊" Icon="Document" Click="ContextDetails" Tag="{x:Bind Id}"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="暫停／停止做種" Icon="Pause" Click="ContextPause" IsEnabled="{x:Bind CanPause, Mode=OneWay}" Tag="{x:Bind Id}"/><MenuFlyoutItem Text="繼續／重試" Icon="Play" Click="ContextResume" IsEnabled="{x:Bind CanResume, Mode=OneWay}" Tag="{x:Bind Id}"/><MenuFlyoutItem Text="修改下載來源" Icon="Edit" Click="ContextEditSource" IsEnabled="{x:Bind CanEditSource, Mode=OneWay}" Tag="{x:Bind Id}"/><MenuFlyoutItem Text="用下一次瀏覽器連結更新來源" Icon="Link" Click="ContextListenSource" IsEnabled="{x:Bind CanEditSource, Mode=OneWay}" Tag="{x:Bind Id}"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="移除" Icon="Delete" Click="ContextDelete" Tag="{x:Bind Id}"/></MenuFlyout></Grid.ContextFlyout>
     </Grid>
    </DataTemplate></ListView.ItemTemplate>
   </ListView>
   <StackPanel Grid.Row="2" x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsHitTestVisible="False"><FontIcon Glyph="&#xE896;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" FontSize="18" HorizontalAlignment="Center"/><TextBlock Text="{x:Bind ViewModel.EmptyHint, Mode=OneWay}" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
  </Grid>
  <Frame x:Name="SettingsFrame" Grid.Row="2" Margin="20,0,20,8" Visibility="Collapsed"/>
  <TextBlock Grid.Row="3" Margin="20,0,20,12" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
 </Grid>
</Page>
