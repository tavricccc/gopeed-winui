<Page x:Class="Gopeed_Native.Views.DownloadConfirmationPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
 <Page.KeyboardAccelerators><KeyboardAccelerator Key="Escape" Invoked="CancelShortcut"/><KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="StartShortcut"/></Page.KeyboardAccelerators>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ContentPresenter x:Name="FormHost" Margin="20,16,20,14"/>
  <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="20,12">
   <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"><Button Content="取消" Click="Cancel" AutomationProperties.AutomationId="CancelDownload"/><Button x:Name="StartButton" Content="檢查連結" Style="{StaticResource AccentButtonStyle}" Click="Start" AutomationProperties.AutomationId="StartDownload"/></StackPanel>
  </Border>
 </Grid>
</Page>
