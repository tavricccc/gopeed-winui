<Page x:Class="Gopeed_Native.Views.DownloadConfirmationPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
 <Grid Padding="24" RowSpacing="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="確認下載" Style="{StaticResource SubtitleTextBlockStyle}"/>
  <ContentPresenter x:Name="FormHost" Grid.Row="1"/>
  <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
   <Button x:Name="StartButton" Content="檢查連結" MinWidth="140" Style="{StaticResource AccentButtonStyle}" Click="Start" AutomationProperties.AutomationId="StartDownload"/>
   <Button Content="取消" MinWidth="100" Click="Cancel" AutomationProperties.AutomationId="CancelDownload"/>
  </StackPanel>
 </Grid>
</Page>
