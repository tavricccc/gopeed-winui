<UserControl x:Class="Gopeed_Native.Views.DownloadForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="14">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="FormContent" Spacing="18">
            <InfoBar x:Name="Message" Severity="Error" IsOpen="False" IsClosable="False" Visibility="Collapsed"/>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="檔名" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBox x:Name="FileName" Grid.Column="1" MinHeight="36" PlaceholderText="使用來源提供的名稱" AutomationProperties.Name="檔名"/>
            </Grid>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="來源" VerticalAlignment="Top" Margin="0,8,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBox x:Name="Links" Grid.Column="1" PlaceholderText="貼上網址；批次下載請每行一個"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="120"
                         AutomationProperties.AutomationId="DownloadLinks" AutomationProperties.Name="來源網址" TextChanged="InputChanged"/>
            </Grid>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="大小" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="Preview" Grid.Column="1" Text="檢查連結後顯示" TextWrapping="Wrap"/>
            </Grid>
            <ComboBox x:Name="Category" Header="下載分類" HorizontalAlignment="Stretch" Visibility="Collapsed" SelectionChanged="CategoryChanged"/>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="存到" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBox x:Name="Destination" Grid.Column="1" MinHeight="36" AutomationProperties.AutomationId="DownloadDestination" AutomationProperties.Name="儲存位置"/>
                <Button Grid.Column="2" Content="瀏覽…" MinHeight="36" Click="PickFolder"/>
            </Grid>
            <StackPanel x:Name="ManualActions" Orientation="Horizontal" Spacing="12">
                <Button x:Name="TorrentPickerButton" Content="選擇 Torrent 檔案" Click="PickTorrent" Style="{ThemeResource SubtleButtonStyle}"/>
                <Button x:Name="RecentLinksButton" Content="最近使用的連結" Click="ShowRecent" Style="{ThemeResource SubtleButtonStyle}"/>
            </StackPanel>
            <StackPanel x:Name="FileSelectionActions" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                <Button Content="全選檔案" Click="SelectAllFiles"/>
                <Button Content="取消全選" Click="SelectNoFiles"/>
            </StackPanel>
            <ListView x:Name="Files" SelectionMode="Multiple" MaxHeight="180" Visibility="Collapsed"/>
            <Expander Header="更多下載選項" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel x:Name="OptionsSurface" Spacing="16">
                    <CheckBox x:Name="DirectDownload" Content="直接開始下載" Checked="DirectChanged" Unchecked="DirectChanged"/>
                    <NumberBox x:Name="Connections" Header="連線數" Value="8" Minimum="1" Maximum="256" SpinButtonPlacementMode="Compact"/>
                    <TextBox x:Name="Headers" Header="HTTP 標頭" PlaceholderText="每行一個，例如 Referer: https://example.com"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="96"/>
                </StackPanel>
            </Expander>
            <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" HorizontalAlignment="Left" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
